{
  "name": "brasfoot-like",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen:default-bank": "pnpm --filter @brasfoot-like/tools gen:default-bank",
    "validate-bank": "pnpm --filter @brasfoot-like/tools validate-bank",
    "gen:stages-mod": "pnpm --filter @brasfoot-like/tools gen:stages-mod",
    "sim:matches": "pnpm --filter @brasfoot-like/tools sim:matches",
    "sim:season": "pnpm --filter @brasfoot-like/tools sim:season",
    "dev:web": "pnpm --filter @brasfoot-like/web dev",
    "build:web": "pnpm --filter @brasfoot-like/web build",
    "preview:web": "pnpm --filter @brasfoot-like/web preview",
    "test:e2e": "pnpm --filter @brasfoot-like/web test:e2e",
    "sim:economy": "pnpm --filter @brasfoot-like/tools sim:economy",
    "sim:world": "pnpm --filter @brasfoot-like/tools sim:world",
    "gen:example-mod": "pnpm --filter @brasfoot-like/tools gen:example-mod",
    "check-release": "pnpm --filter @brasfoot-like/tools check-release",
    "screenshots": "pnpm --filter @brasfoot-like/tools screenshots",
    "sim:size": "pnpm --filter @brasfoot-like/tools sim:size",
    "gen:world-mod": "pnpm --filter @brasfoot-like/tools gen:world-mod",
    "gen:continental-mod": "pnpm --filter @brasfoot-like/tools gen:continental-mod",
    "gen:regional-mod": "pnpm --filter @brasfoot-like/tools gen:regional-mod",
    "gen:football-world": "pnpm --filter @brasfoot-like/tools gen:football-world"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "version": "1.0.0"
}
