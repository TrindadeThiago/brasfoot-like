#!/bin/sh
# Pré-push (opt-in: `pnpm hooks:install`): roda as simulações de 30 temporadas localmente quando o push
# muda o motor, o formato de save, o formato de mod ou as ferramentas. Elas saíram do CI para
# economizar minutos de Actions (release.yml só confere tipos, lint, build e check-release).
# Para pular de propósito: SKIP_SIMS=1 git push.

[ "${SKIP_SIMS:-}" = "1" ] && exit 0

ZERO=0000000000000000000000000000000000000000
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # apagar branch: nada a conferir
  if [ "$remote_sha" = "$ZERO" ]; then
    # Branch nova: compara com o ponto de partida mais provável.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    for candidate in origin/release/v1.0.0; do
      other=$(git merge-base "$local_sha" "$candidate" 2>/dev/null || true)
      [ -n "$other" ] && base="$other"
    done
  else
    base="$remote_sha"
  fi
  [ -z "$base" ] && base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
  changed="$changed
$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"
done

if printf '%s\n' "$changed" | grep -Eq '^(packages/(engine|save|modkit)/|tools/|mods/|pnpm-lock\.yaml$)'; then
  echo "pré-push: o push mexe no motor, no save, no modkit ou nas ferramentas: rodando as simulações (pnpm sim:gates)."
  echo "          (SKIP_SIMS=1 git push pula)"
  pnpm sim:gates || {
    echo "pré-push: as simulações falharam; o push foi cancelado." >&2
    exit 1
  }
else
  echo "pré-push: nada do motor, do save ou das ferramentas mudou; simulações puladas."
fi
exit 0
